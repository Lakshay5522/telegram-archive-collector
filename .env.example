# ---------------------------------------------------------------------------
# Telegram Archive Collector — configuration template
# Copy to .env, fill in the values, then `chmod 600 .env`.
# Never commit the real .env, the *.session file or the SQLite database.
# ---------------------------------------------------------------------------

# --- Telegram credentials (https://my.telegram.org -> API development tools)
API_ID=123456
API_HASH=00000000000000000000000000000000

# --- Where collected messages are forwarded (a private channel YOU control)
# Public username (@name) or canonical numeric id (-100... for channels).
DESTINATION_CHAT=@my_private_archive

# --- Source chats: comma separated, one per line allowed.
# identifier | alias | disabled
# Use the "chat id" column printed by `python -m collector list-groups`
# (marked peer id, e.g. -1001234567890) or a @username.
#   @public_group
#   -1001234567890|private group A
#   https://t.me/+AbCdEfGh|invite already joined
SOURCE_GROUPS=
#  -1001111111111|group one
#  -1002222222222|group two|disabled

# --- Storage (keep these on persistent disk)
DATA_DIR=./data
SESSION_PATH=./data/collector.session
DATABASE_PATH=./data/collector.sqlite3
LOG_DIR=./data/logs
# 0700 directories, 0600 session/database, umask 0077
RESTRICT_PERMISSIONS=true

# --- Forwarding behaviour
# forward = native Telegram forward (default, preserves attribution)
# copy    = send a new copy (loses attribution; explicit opt-in only)
FORWARD_MODE=forward
# Send "[source] title · chat id · message id" before each forward
ANNOTATE_SOURCE=false
# Post an annotation when a source message is edited / deleted
INCLUDE_EDITS=false
INCLUDE_DELETED=false
# Forward service messages (joins, pins, title changes)
INCLUDE_SERVICE_MESSAGES=false
# Import messages the account itself sent in the source groups
INCLUDE_OUTGOING=false

# --- Historical import window (blank = all accessible history)
# Both dates are inclusive. HISTORY_MAX_COUNT is a TOTAL budget per group,
# counted in scanned messages, across restarts.
HISTORY_START_DATE=
HISTORY_END_DATE=
HISTORY_MAX_COUNT=
HISTORY_BATCH_SIZE=100

# --- Queue, retries and rate limiting
WORKER_CONCURRENCY=1
QUEUE_POLL_INTERVAL=2
LEASE_SECONDS=300
MAX_ATTEMPTS=5
# Before retrying a request that may already have landed, look for it at the
# destination (one bounded history read per retried unit). This is what closes
# the "forwarded but the response never arrived" duplicate window.
VERIFY_BEFORE_RETRY=true
RETRY_VERIFY_SCAN_LIMIT=100
BACKOFF_BASE=2
BACKOFF_CAP=900
MIN_FORWARD_INTERVAL=0.6

# --- Supervision and observability
# Heartbeat drives /ready and the "health" line in `collector status`.
HEARTBEAT_INTERVAL=30
# Watchdog: how often to resume incomplete imports / prune old events.
IMPORT_RECHECK_INTERVAL=300
# Health reports "degraded" once the heartbeat is older than this.
STALE_HEARTBEAT_SECONDS=180
# Default destination-history window for `reconcile`.
RECONCILE_SCAN_LIMIT=500
# Delete audit events older than N days (0 keeps everything).
EVENT_RETENTION_DAYS=30

# --- Optional dashboard (HTTP Basic auth, read-only database, never public
#     without TLS). /health = liveness, /ready = real collector health.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
